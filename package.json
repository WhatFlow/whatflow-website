{
  "name": "whatflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run docs:index",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "tsx scripts/migrate-cms.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "seed:changelog": "tsx scripts/seed-changelog.ts",
    "cms:check": "tsx scripts/migrate-cms.mjs --check",
    "predeploy": "npm run migrate -- --remote",
    "docs:index": "tsx scripts/build-docs-search.ts",
    "docs:check": "tsx scripts/build-docs-search.ts --check"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.11",
    "@opennextjs/cloudflare": "^1.19.9",
    "@payloadcms/db-d1-sqlite": "^3.87.0",
    "@payloadcms/next": "^3.87.0",
    "@payloadcms/plugin-mcp": "^3.87.0",
    "@payloadcms/richtext-lexical": "^3.87.0",
    "@payloadcms/storage-r2": "^3.87.0",
    "@payloadcms/ui": "^3.87.0",
    "graphql": "^16.14.2",
    "lenis": "1.3.27",
    "next": "16.2.11",
    "payload": "^3.87.0",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "github-slugger": "^2.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "wrangler": "^4.118.0"
  },
  "type": "module"
}
