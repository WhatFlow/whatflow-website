# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
__pycache__/
*.pyc
next-env.d.ts

# OpenNext
/.open-next

# wrangler files
.wrangler
.dev.vars*


!.dev.vars.example

# CMS working copies. Payload (D1) is the source of truth for posts and comparisons;
# keep only briefs and release notes in git, never article bodies or generated SQL.
/content/blog/refresh-2026-11-05/*
!/content/blog/refresh-2026-11-05/STYLE.md
!/content/blog/refresh-2026-11-05/REPORT.md
/content/comparisons/refresh-2026-11-05/*
!/content/comparisons/refresh-2026-11-05/BRIEF.md
/content/blog/audit-2026-11-11/*
!/content/blog/audit-2026-11-11/BRIEF.md
!/content/blog/audit-2026-11-11/REPORT.md
/content/comparisons/audit-2026-11-11/*
!/content/comparisons/audit-2026-11-11/BRIEF.md
