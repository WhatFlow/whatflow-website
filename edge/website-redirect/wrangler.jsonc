{
  "name": "whatflow-website-redirect",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "whatflow.tech", "zone_name": "whatflow.tech", "custom_domain": true },
    { "pattern": "www.whatflow.tech/*", "zone_name": "whatflow.tech" },
    { "pattern": "www.whatflow.io", "zone_name": "whatflow.io", "custom_domain": true }
  ]
}
